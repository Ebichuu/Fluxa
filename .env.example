# Fluxa v2 环境配置（首次打开页面创建管理员账号；以下连接项均可在网页设置页随时修改，无需重启）
MCC_DATA_ROOT=./runtime

# MoviePilot Neo（可选，也可在设置页填写）
MOVIEPILOT_BASE_URL=
MOVIEPILOT_API_TOKEN=

# Torra
TORRA_BASE_URL=
TORRA_TOKEN=

# qBittorrent
QB_BASE_URL=
QB_USERNAME=
QB_PASSWORD=

# Symedia (SA)
SYMEDIA_BASE_URL=
SYMEDIA_TOKEN=

# Emby
EMBY_BASE_URL=
EMBY_API_KEY=
EMBY_USER_ID=

# TMDB（API Key 或 Bearer Token 填一种即可）
